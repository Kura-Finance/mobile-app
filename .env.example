# ============================================================================
# Kura Wallet — Mobile Client (open source)
# 复制为 .env 并填入你的密钥 / Copy to .env and fill in your keys
# ============================================================================
# 官方 App 使用 Kura 托管后端；fork 可留空 EXPO_PUBLIC_API_BASE_URL 以仅启用
# 核心钱包功能。详见 docs/official-services.md
#
# The official app uses Kura's hosted backend. Forks may leave
# EXPO_PUBLIC_API_BASE_URL empty to run core wallet features only.
#
# Development:  cp .env.example .env  →  set APP_ENV/NODE_ENV below to development
# Store release: same file — switch APP_ENV/NODE_ENV to production and use production
#                values noted in comments. EXPO_PUBLIC_* are embedded at build time.
#                See docs/local-release.md
# ============================================================================

# --- Environment (development | production) ---
APP_ENV=development
NODE_ENV=development
# Store release: APP_ENV=production  NODE_ENV=production

# --- Kura backend (optional for forks; required for TrackFi / Dinari / Plaid) ---
# DeBank OpenAPI key lives on the backend only — mobile uses /api/debank/* proxy.
EXPO_PUBLIC_API_BASE_URL=
# EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:8080
# Official store build: EXPO_PUBLIC_API_BASE_URL=https://api.kura-finance.com

# --- Privy (required for login) — https://privy.io ---
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

# --- WalletConnect / Reown — https://cloud.reown.com ---
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
# EXPO_PUBLIC_KURA_WALLET_ICON_URL=https://your-domain.com/icon.png

# --- Smart account (Base) — https://dashboard.pimlico.io ---
EXPO_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key
# Base RPC — Alchemy (recommended): https://dashboard.alchemy.com → Create App → Base Mainnet
EXPO_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
# Or set a custom RPC URL when Alchemy key is unset:
# EXPO_PUBLIC_BASE_RPC_URL=https://base.llamarpc.com
EXPO_PUBLIC_PAY_GAS_IN_USDC=true

# --- Li.Fi (optional integrator fee) — https://li.fi/dashboard ---
EXPO_PUBLIC_LIFI_INTEGRATOR=
EXPO_PUBLIC_LIFI_FEE=
# EXPO_PUBLIC_LIFI_API_KEY=

# --- Morpho Earn (Base vault yield — public Morpho API + Pimlico smart account) ---
# Set to false to hide Discover → Earn tab. Default: enabled when EXPO_PUBLIC_PIMLICO_API_KEY is set.
# EXPO_PUBLIC_MORPHO_EARN_ENABLED=true
# JSON array of vault addresses to list (defaults to Steakhouse USDC + Gauntlet EURC + Gauntlet USDC on Base):
# EXPO_PUBLIC_MORPHO_EARN_VAULT_ALLOWLIST=["0xbeef0e0834849aCC03f0089F01f4F1Eeb06873C9","0x94Af495DE1F56Aa5576dEB17986bDCeE5Dd9778D","0x050cE30b927Da55177A4914EC73480238BAD56f0"]
# Optional service fee on vault yield (requires Morpho fee-wrapper deployment):
EXPO_PUBLIC_MORPHO_EARN_FEE=0.1
EXPO_PUBLIC_KURA_EARN_FEE_RECIPIENT=
# Inner vault → Kura fee-wrapper (defaults in src/config/earnFeeWrapper.ts; env overrides per key):
# EXPO_PUBLIC_MORPHO_FEE_WRAPPER_OVERRIDES={"0xbeef0e0834849aCC03f0089F01f4F1Eeb06873C9":"0x0F457aa0AfD3D208cbfEE520804118f88965a529","0x94Af495DE1F56Aa5576dEB17986bDCeE5Dd9778D":"0x6D10990b11f88EE40e4ABc2f8CbE1f7194190Db0","0x050cE30b927Da55177A4914EC73480238BAD56f0":"0x50e8B8B50037322BE0Efc2048d66Cb957f349816"}
# Set false to disable Morpho API fee-wrapper auto-discovery (overrides-only mode):
# EXPO_PUBLIC_MORPHO_FEE_WRAPPER_AUTO_DISCOVER=false

# --- Gnosis Pay (optional) — https://docs.gnosispay.com ---
EXPO_PUBLIC_GP_API_URL=https://app.gnosispay.com
EXPO_PUBLIC_GP_DIRECT_ENABLED=true
# Store release: EXPO_PUBLIC_GP_DIRECT_ENABLED=true
EXPO_PUBLIC_GP_API_BASE_URL=https://api.gnosispay.com
EXPO_PUBLIC_GP_SIWE_DOMAIN=localhost
# Store release: EXPO_PUBLIC_GP_SIWE_DOMAIN=api.kura-finance.com
EXPO_PUBLIC_GP_SIWE_URI=https://app.gnosispay.com
EXPO_PUBLIC_GP_PARTNER_ID=
# Store release: EXPO_PUBLIC_GP_PARTNER_ID=your_gp_partner_id
EXPO_PUBLIC_GP_JWT_TTL_SECONDS=43200

# --- MoonPay (optional) — https://dashboard.moonpay.com ---
EXPO_PUBLIC_MOONPAY_API_KEY=
EXPO_PUBLIC_MOONPAY_ENV=sandbox
EXPO_PUBLIC_MOONPAY_CURRENCY_CODE=usdc_base

# --- logo.dev (optional stock logos) — https://logo.dev ---
EXPO_PUBLIC_LOGODEV_TOKEN=

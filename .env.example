# ============================================================================
# Mobile client — environment template
# Copy to .env and fill in REQUIRED keys only.
# Prefer free public endpoints; optional keys raise rate limits.
#
#   cp .env.example .env
#   npx expo start -c   # restart after any EXPO_PUBLIC_* change
#
# Wallet-only: leave EXPO_PUBLIC_API_BASE_URL empty.
# Store release: set APP_ENV/NODE_ENV=production before prebuild.
# See docs/getting-started.md · docs/official-services.md
# ============================================================================

# --- Environment ---
APP_ENV=development
NODE_ENV=development

# =============================================================================
# REQUIRED — core wallet (login + smart account + WalletConnect)
# =============================================================================

# Privy — https://dashboard.privy.io
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

# WalletConnect / Reown — https://cloud.reown.com
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Pimlico — https://dashboard.pimlico.io
# Key + PAY_GAS_IN_USDC=true → user pays gas in USDC (ERC-20 paymaster)
# Otherwise (no key, or false) → user pays gas in ETH (public bundler if no key)
# EXPO_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key
EXPO_PUBLIC_PAY_GAS_IN_USDC=true

# =============================================================================
# PUBLIC DEFAULTS — no API key (override only if needed)
# =============================================================================

# Base mainnet RPC — free public node (fallback built into the app)
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# Or any other HTTPS JSON-RPC URL, e.g. https://base.llamarpc.com

# Li.Fi swap / bridge — public https://li.quest/v1 (no key)
# Morpho Earn vaults — public https://api.morpho.org/graphql (no key)
# CoinGecko prices — public https://api.coingecko.com (no key)
# Tx history — public Base Blockscout (no key)

# =============================================================================
# OPTIONAL — hosted backend (TrackFi / Plaid / DeBank / Dinari)
# =============================================================================

EXPO_PUBLIC_API_BASE_URL=
# EXPO_PUBLIC_API_BASE_URL_DEV=http://localhost:8080
# Official store example: EXPO_PUBLIC_API_BASE_URL=https://api.kura-finance.com

# =============================================================================
# OPTIONAL — Li.Fi integrator fee — https://portal.li.fi/
# =============================================================================
# Both required to collect a fee. Register integrator + payout wallet first.
# fee = fraction of from-amount, e.g. 0.0025 = 0.25%
# EXPO_PUBLIC_LIFI_INTEGRATOR=
# EXPO_PUBLIC_LIFI_FEE=
# EXPO_PUBLIC_LIFI_API_KEY=

# =============================================================================
# OPTIONAL — Morpho Earn fee-wrapper (default: deposit directly to Morpho)
# =============================================================================
# Morpho Earn — default on when Pimlico is set; set false to hide Invest → Earn
# EXPO_PUBLIC_MORPHO_EARN_ENABLED=true
# EXPO_PUBLIC_MORPHO_EARN_VAULT_ALLOWLIST=["0xbeef0e0834849aCC03f0089F01f4F1Eeb06873C9","0x94Af495DE1F56Aa5576dEB17986bDCeE5Dd9778D","0x050cE30b927Da55177A4914EC73480238BAD56f0","0x1deEfABEe758AAbdC29a542B24ca3b75aFD56765"]
# Performance fee on yield (0–1). Leave unset / 0 for direct Morpho deposits.
# EXPO_PUBLIC_MORPHO_EARN_FEE=0.1
# EXPO_PUBLIC_EARN_FEE_RECIPIENT=0xYourTreasury…
# Inner vault → fee-wrapper map (sample from EXAMPLE_MORPHO_FEE_WRAPPER_OVERRIDES):
# EXPO_PUBLIC_MORPHO_FEE_WRAPPER_OVERRIDES={"0xbeef0e0834849aCC03f0089F01f4F1Eeb06873C9":"0x0F457aa0AfD3D208cbfEE520804118f88965a529","0x94Af495DE1F56Aa5576dEB17986bDCeE5Dd9778D":"0x6D10990b11f88EE40e4ABc2f8CbE1f7194190Db0","0x050cE30b927Da55177A4914EC73480238BAD56f0":"0x50e8B8B50037322BE0Efc2048d66Cb957f349816","0x1deEfABEe758AAbdC29a542B24ca3b75aFD56765":"0x07540AeeD4B12408c87365417aE7CE59A966CA47"}
# Discover matching FeeWrapper vaults from Morpho API (needs fee + recipient):
# EXPO_PUBLIC_MORPHO_FEE_WRAPPER_AUTO_DISCOVER=true

# =============================================================================
# OPTIONAL — nicer logos / higher rate limits
# =============================================================================

# logo.dev publishable key (pk_…) — unset → glyph / Clearbit fallbacks
# EXPO_PUBLIC_LOGODEV_TOKEN=

# CoinGecko Demo API key — unset → free public API (rate-limited)
# EXPO_PUBLIC_COINGECKO_API_KEY=

# WalletConnect listing icon (defaults to brand.defaultIconUrl)
# EXPO_PUBLIC_WALLET_ICON_URL=https://your-domain.com/icon.png
